{
  "id": "dialogs",
  "title": "Alerts",
  "version": "1.0.0",
  "order": 30,
  "icon": "window",
  "description": "Fake error dialogs that cascade over the phone strip: title bar, icon, message, buttons. Messages come from the shared pool.",
  "channels": ["dialogs"],
  "mount": "routes.js",
  "ui": {
    "pane": "ui/pane.js",
    "style": "ui/pane.css"
  },
  "settings": {
    "theme": { "type": "enum", "default": "win11", "values": ["win95", "win11", "macos"], "label": "Window theme" },
    "scale": { "type": "number", "default": 0.7, "min": 0.5, "max": 1.2, "label": "Scale" },
    "sound": { "type": "boolean", "default": true, "label": "Sound" },
    "volume": { "type": "number", "default": 0.6, "min": 0, "max": 1, "label": "Volume" }
  },
  "pages": [
    { "route": "/dialogs", "title": "Alert overlay", "file": "overlay/index.html" }
  ]
}
