{
  "id": "wall",
  "title": "LED Wall",
  "version": "1.0.0",
  "description": "The dot-matrix wall: patterns, presets, text pool, blackout, ratio fence.",
  "mount": "server.js",
  "ui": {
    "icon": "wall",
    "order": 10,
    "pane": "ui/pane.js",
    "style": "ui/pane.css"
  },
  "pages": [
    {
      "route": "/wall/render",
      "file": "engine/display.html",
      "title": "LED wall (16:9 render surface, OBS browser source)"
    }
  ],
  "settings": {
    "pattern": {
      "type": "string",
      "default": "wave",
      "group": "look"
    },
    "preset": {
      "type": "string",
      "default": "default",
      "group": "look"
    },
    "brightness": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 2,
      "group": "look"
    },
    "speed": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 4,
      "group": "look"
    },
    "ratio": {
      "type": "string",
      "default": "16:9",
      "enum": [
        "16:9",
        "9:16"
      ],
      "group": "fence"
    },
    "fence": {
      "type": "object",
      "default": {
        "x": 880,
        "y": 0,
        "w": 1440,
        "h": 2560
      },
      "note": "Landscape 1280x720 source at scale 2: the 9:16 window is 1440x2560 px, centred; x = (2560-1440)/2",
      "group": "fence"
    },
    "fenceOutDim": {
      "type": "number",
      "default": 0.18,
      "min": 0,
      "max": 1,
      "group": "fence"
    },
    "gridCols": {
      "type": "number",
      "default": 112,
      "min": 16,
      "max": 200,
      "step": 1,
      "group": "look"
    },
    "gridColsPortrait": {
      "type": "number",
      "default": 63,
      "min": 16,
      "max": 120,
      "step": 1,
      "group": "look"
    },
    "gridRows": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 160,
      "step": 1,
      "group": "look"
    },
    "cellShape": {
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.05,
      "group": "look"
    },
    "ledSize": {
      "type": "number",
      "default": 1,
      "min": 0.3,
      "max": 2.5,
      "step": 0.05,
      "group": "look"
    },
    "transitionSpeed": {
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.05,
      "group": "look"
    },
    "flashDensity": {
      "type": "number",
      "default": 0.25,
      "min": 0,
      "max": 0.6,
      "step": 0.01,
      "group": "look"
    },
    "waveFrequency": {
      "type": "number",
      "default": 3,
      "min": 0.5,
      "max": 10,
      "step": 0.1,
      "group": "look"
    },
    "persistence": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 0.95,
      "step": 0.01,
      "group": "look"
    },
    "paletteWeight": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "look"
    },
    "hdrGain": {
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 8,
      "step": 0.1,
      "group": "look"
    },
    "streakOpacity": {
      "type": "number",
      "default": 0.12,
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "group": "look"
    },
    "flareIntensity": {
      "type": "number",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "look"
    },
    "flareLength": {
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "look"
    },
    "flareRotation": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 45,
      "step": 1,
      "group": "look"
    },
    "bloom": {
      "type": "number",
      "default": 0.55,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "group": "look"
    },
    "bloomThreshold": {
      "type": "number",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "look"
    },
    "bloomRadius": {
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.05,
      "group": "look"
    },
    "exposure": {
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.05,
      "group": "look"
    },
    "saturation": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "group": "look"
    },
    "contrast": {
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 1.8,
      "step": 0.05,
      "group": "look"
    },
    "lift": {
      "type": "number",
      "default": 0,
      "min": -0.2,
      "max": 0.2,
      "step": 0.01,
      "group": "look"
    },
    "vignette": {
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "group": "look"
    },
    "grain": {
      "type": "number",
      "default": 0.03,
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "group": "look"
    },
    "dither": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 1,
      "group": "look"
    },
    "acsTonemap": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 1,
      "group": "look"
    }
  }
}
