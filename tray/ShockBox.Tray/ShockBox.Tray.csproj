<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ShockBox.Tray</AssemblyName>
    <RootNamespace>ShockBox.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The WebView2 package also ships WebView2.Wpf.dll, which references a WindowsBase
         version the WinForms assembly set does not match: a benign MSB3277 on every build.
         This app uses the WinForms control only, so the conflict is noise to silence. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>
</Project>
