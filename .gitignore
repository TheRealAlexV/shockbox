# ---- ShockBox: never commit live state, models, captures or secrets ----

# operator state (wall pool, notifications messages, settings, logs)
state/
state-dev/
*.log
*.log.1
logs/

# one-time adopted legacy data
**/.backups/

# local config (contains the obs-websocket password on the rig)
config.json
config.local.json

# hand FX models and captures (large, and some are licensed per-machine)
modules/handfx/models/*
!modules/handfx/models/.gitkeep
captures/
*.mp4
*.webm

# builds
node_modules/
public/assets/
.vite/
dist/

# Python: the TUI's own venvs (the dev one in tools/tui and the rig's .tui-venv --
# both hold absolute paths from the machine that made them, so neither can ship)
.venv/
.tui-venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# public/index.html is the shell's entry document (source, not a build output): it is served
# directly from public/, and an untracked copy means CI checks out a repo with no shell at all.

# editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
# CocoIndex Code (ccc)
/.cocoindex_code/

# Agent tooling scratch (never shipped)
/.openchamber/
/.opencode/
/.cortexkit/
